# Offline application upgrade; dependencies and tokenizer are unchanged from 0.17.0.
FROM agent-hub:0.17.0 AS runtime
USER root
WORKDIR /app
RUN rm -rf /app/src /app/migrations
COPY pyproject.toml alembic.ini requirements.lock ./
COPY src ./src
COPY migrations ./migrations
RUN PIP_NO_INDEX=1 pip install --no-deps --no-build-isolation . && pip check
USER 10001
EXPOSE 8765
CMD ["agent-hub", "serve", "--host", "0.0.0.0", "--port", "8765"]
