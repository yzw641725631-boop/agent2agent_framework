# Server configuration reference only. Live secrets stay in /opt/agent-hub/database/.env.
# Database and Docker must run on the authorized server, not on a developer workstation.
HUB_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
HUB_OWNER_PASSWORD=REPLACE_WITH_RANDOM_HEX
HUB_RUNTIME_PASSWORD=REPLACE_WITH_RANDOM_HEX
HUB_INDEXER_PASSWORD=REPLACE_WITH_RANDOM_HEX
HUB_MEMORY_PASSWORD=REPLACE_WITH_RANDOM_HEX
HUB_EMBEDDING_PASSWORD=REPLACE_WITH_RANDOM_HEX
HUB_GENERATION_PASSWORD=REPLACE_WITH_RANDOM_HEX
HUB_SECRET=REPLACE_WITH_RANDOM_HEX
HUB_ENVIRONMENT=development
HUB_PUBLIC_URL=http://127.0.0.1:8765
HUB_EMBEDDING_URL=
HUB_SMTP_HOST=
HUB_SMTP_PORT=587
HUB_SMTP_FROM=
HUB_SMTP_USERNAME=
HUB_SMTP_PASSWORD=
HUB_SMTP_STARTTLS=true
